+    if ((RLGL.State.currentBlendMode != mode) || ((mode == RL_BLEND_CUSTOM || mode == RL_BLEND_CUSTOM_SEPARATE) && RLGL.State.glCustomBlendModeModified))
+    {
+        rlRenderBatch *b = RLGL.currentBatch;
+        rlDrawCall *d = &b->draws[b->drawCounter - 1];
+        bool custom = (mode == RL_BLEND_CUSTOM) || (mode == RL_BLEND_CUSTOM_SEPARATE) ||
+                      (RLGL.State.currentBlendMode == RL_BLEND_CUSTOM) || (RLGL.State.currentBlendMode == RL_BLEND_CUSTOM_SEPARATE);
