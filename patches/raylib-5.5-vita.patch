 // Define one vertex (texture coordinate)
 // NOTE: Texture coordinates are limited to QUADS only
+// VS (Vita): i 4 vertici di un quad in un colpo, dopo rlBegin(RL_QUADS). Stesso effetto di 4 rlTexCoord2f + rlVertex2f
+// (trasformazione, profondita', normale e colore correnti), senza 4 chiamate fra file diversi: sulla Vita il percorso per
+// vertice costava ~3,5 us a quad (misurato 2026-11-01 con VS_BENCH=quads2000)
+void rlQuad4(const float *xy, const float *uv)
+{
+    if (RLGL.State.vertexCounter > (RLGL.currentBatch->vertexBuffer[RLGL.currentBatch->currentBuffer].elementCount*4 - 4)) rlCheckRenderBatchLimit(4 + 1);
+    rlVertexBuffer *vb = &RLGL.currentBatch->vertexBuffer[RLGL.currentBatch->currentBuffer];
+    int n = RLGL.State.vertexCounter;
+    float z = RLGL.currentBatch->currentDepth;
+    const Matrix t = RLGL.State.transform;  // campi per nome: Matrix e' m0, m4, m8, m12, m1... (non un array in ordine)
+    int tr = RLGL.State.transformRequired;
+    for (int k = 0; k < 4; k++, n++)
+    {
+        float x = xy[2*k], y = xy[2*k + 1];
+        if (tr)
+        {
+            vb->vertices[3*n] = t.m0*x + t.m4*y + t.m8*z + t.m12;
+            vb->vertices[3*n + 1] = t.m1*x + t.m5*y + t.m9*z + t.m13;
+            vb->vertices[3*n + 2] = t.m2*x + t.m6*y + t.m10*z + t.m14;
+        }
+        else { vb->vertices[3*n] = x; vb->vertices[3*n + 1] = y; vb->vertices[3*n + 2] = z; }
+        vb->texcoords[2*n] = uv[2*k];
+        vb->texcoords[2*n + 1] = uv[2*k + 1];
+        vb->normals[3*n] = RLGL.State.normalx;
+        vb->normals[3*n + 1] = RLGL.State.normaly;
+        vb->normals[3*n + 2] = RLGL.State.normalz;
+        vb->colors[4*n] = RLGL.State.colorr;
+        vb->colors[4*n + 1] = RLGL.State.colorg;
+        vb->colors[4*n + 2] = RLGL.State.colorb;
+        vb->colors[4*n + 3] = RLGL.State.colora;
+    }
+    RLGL.State.vertexCounter = n;
+    RLGL.currentBatch->draws[RLGL.currentBatch->drawCounter - 1].vertexCount += 4;
+}
